  "info": {
    "_postman_id": "d54597c1-ae7d-4bf0-b5c7-2442c9fe3324",
    "name": "US Senate Lobbying Disclosure Act (LDA) Clients API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Senate Lobbying Disclosure Act (LDA) REST API provides public access to lobbying filings, registrations, quarterly activity reports (LD-2), and semi-annual contribution reports (LD-203). An optional API key increases the rate limit from 15 to 120 requests per minute.\n\nContact Support:\n Name: Senate Office of Public Records\n Email: lobby@sec.senate.gov",
      "type": "text/plain"
    }
  }
